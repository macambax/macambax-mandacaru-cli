# Mandacaru — Credentials Template
# Copy this file to ~/.mandacaru/.env and fill in your values.
# NEVER commit real credentials to version control.

# ─── OpenAI ────────────────────────────────────────────────
# Usage API key with read-only billing access
OPENAI_API_KEY=sk-...

# ─── Google Cloud Platform ─────────────────────────────────
# Path to service account JSON (billing.viewer role only)
GOOGLE_APPLICATION_CREDENTIALS=~/.mandacaru/gcp-billing-sa.json
GCP_PROJECT_ID=your-project-id

# ─── Vercel ────────────────────────────────────────────────
# Read-only token for billing data
VERCEL_TOKEN=...
